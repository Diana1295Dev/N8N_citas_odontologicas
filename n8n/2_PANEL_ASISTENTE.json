        "jsCode": "const lit = (v) => (v === null || v === undefined) ? 'null' : \"'\" + String(v).replace(/'/g, \"''\") + \"'\";\nconst num = (v) => { const x = Number(v); if (!Number.isFinite(x)) throw new Error('número inválido'); return String(Math.round(x)); };\nconst id = String(($('POST cancelar').first().json.body || {}).id || '');\nif (!/^[A-Za-z0-9-]{4,20}$/.test(id)) throw new Error('id inválido');\nreturn [{ json: { id, sql: \"update citas set estado = 'Cancelada' where id = \" + lit(id) + \" and estado <> 'Cancelada' returning id;\" } }];"
