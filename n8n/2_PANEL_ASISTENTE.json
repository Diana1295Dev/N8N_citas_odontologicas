        "operation": "executeQuery",
        "query": "select id, to_char(fecha, 'YYYY-MM-DD') as fecha, to_char(hora, 'HH24:MI') as hora, duracion_min, nombre, telefono, email,\n  servicio, servicio_nombre, notas, estado, telegram_chat is not null as telegram, cambios, creada_en\nfrom citas\nwhere fecha >= current_date - 60\norder by fecha, hora;",
        "options": {}
