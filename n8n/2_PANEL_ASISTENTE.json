      },
      "id": "b2c3d4e5-0105-4000-8000-000000000000",
      "name": "GET horario",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "horario-get"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select\n  (select row_to_json(h) from horario h where id = 1) as horario,\n  coalesce((select json_agg(to_char(fecha, 'YYYY-MM-DD') order by fecha) from no_atiende where fecha >= current_date - 7), '[]'::json) as no_atiende,\n  coalesce((select json_agg(json_build_object('fecha', to_char(fecha, 'YYYY-MM-DD'), 'hora', to_char(hora, 'HH24:MI'), 'dur', duracion_min))\n            from citas where estado <> 'Cancelada' and fecha >= current_date - 1), '[]'::json) as citas;",
        "options": {}
      },
      "id": "b2c3d4e5-0106-4000-8000-000000000000",
      "name": "Leer horario",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "vBVjvF7Tiq9epFlO",
          "name": "Neon citas"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Convierte la fila de la base al formato del panel de la asistente\nconst r = $input.first().json;\nconst h = r.horario;\nreturn [{ json: {\n  patron: {\n    dias: h.dias || [],\n    manana: { on: h.manana_on, ini: h.manana_ini, fin: h.manana_fin },\n    tarde: { on: h.tarde_on, ini: h.tarde_ini, fin: h.tarde_fin },\n  },\n  marcas: { no_atiende: r.no_atiende || [] },\n  actualizado_en: h.actualizado_en,\n} }];"
      },
      "id": "b2c3d4e5-0107-4000-8000-000000000000",
      "name": "Armar horario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "b2c3d4e5-0108-4000-8000-000000000000",
      "name": "Responder horario",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "horario",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "b2c3d4e5-0109-4000-8000-000000000000",
      "name": "POST horario",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        460
      ],
      "webhookId": "horario-post"
    },
    {
      "parameters": {
        "jsCode": "// Valida lo que envía el panel y arma el SQL para guardarlo\nconst lit = (v) => (v === null || v === undefined) ? 'null' : \"'\" + String(v).replace(/'/g, \"''\") + \"'\";\nconst num = (v) => { const x = Number(v); if (!Number.isFinite(x)) throw new Error('número inválido'); return String(Math.round(x)); };\nconst b = $('POST horario').first().json.body || {};\nconst p = b.patron || {};\nconst dias = [...new Set((p.dias || []).map(Number).filter((d) => Number.isInteger(d) && d >= 0 && d <= 5))].sort();\nconst per = (x) => ({ on: Boolean(x && x.on), ini: Number(x && x.ini), fin: Number(x && x.fin) });\nconst m = per(p.manana);\nconst t = per(p.tarde);\nfor (const x of [m, t]) if (!(x.ini >= 0 && x.fin <= 1440 && x.ini < x.fin)) throw new Error('horario inválido');\nconst fechas = [...new Set(((b.marcas && b.marcas.no_atiende) || []).filter((f) => /^\\d{4}-\\d{2}-\\d{2}$/.test(f)))];\nconst sql = [\n  'begin;',\n  \"update horario set dias = '{\" + dias.join(',') + \"}', manana_on = \" + m.on + ', manana_ini = ' + num(m.ini) + ', manana_fin = ' + num(m.fin)\n    + ', tarde_on = ' + t.on + ', tarde_ini = ' + num(t.ini) + ', tarde_fin = ' + num(t.fin) + ', actualizado_en = now() where id = 1;',\n  'delete from no_atiende where fecha >= current_date - 7;',\n  fechas.length ? 'insert into no_atiende (fecha) values ' + fechas.map((f) => '(' + lit(f) + ')').join(', ') + ' on conflict do nothing;' : '',\n  'commit;',\n  \"select 'ok' as resultado;\",\n].join('\\n');\nreturn [{ json: { sql } }];"
      },
      "id": "b2c3d4e5-0110-4000-8000-000000000000",
      "name": "SQL guardar horario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        460
      ]
    },
