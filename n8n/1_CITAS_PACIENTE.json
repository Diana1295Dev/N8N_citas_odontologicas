    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select\n  (select row_to_json(h) from horario h where id = 1) as horario,\n  coalesce((select json_agg(to_char(fecha, 'YYYY-MM-DD') order by fecha) from no_atiende where fecha >= current_date - 7), '[]'::json) as no_atiende,\n  coalesce((select json_agg(json_build_object('fecha', to_char(fecha, 'YYYY-MM-DD'), 'hora', to_char(hora, 'HH24:MI'), 'dur', duracion_min))\n            from citas where estado <> 'Cancelada' and fecha >= current_date - 1), '[]'::json) as citas;",
        "options": {}
      },
      "id": "b2c3d4e5-0102-4000-8000-000000000000",
      "name": "Leer agenda",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        1800
      ],
      "credentials": {
        "postgres": {
          "id": "vBVjvF7Tiq9epFlO",
          "name": "Neon citas"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Horas libres de una semana (lunes a sábado), con el mismo formato que espera la app\nconst q = $('GET disponibilidad').first().json.query || {};\nconst DUR = { valoracion: 30, limpieza: 30, blanqueamiento: 60, ortodoncia: 45 };\nconst dur = DUR[q.servicio];\nconst r = $input.first().json;\nconst h = r.horario;\nconst noAtiende = new Set(r.no_atiende || []);\nconst ahora = DateTime.now().setZone('America/Bogota');\nconst hoy = ahora.toISODate();\nconst minAhora = ahora.hour * 60 + ahora.minute;\nlet lunes = DateTime.fromISO(String(q.semana || ''), { zone: 'America/Bogota' });\nif (!lunes.isValid || !dur) return [{ json: { error: 'parametros_invalidos' } }];\nlunes = lunes.minus({ days: lunes.weekday - 1 });\n// Ventana de 8 semanas desde la actual (si hoy es domingo, desde el lunes siguiente)\nlet base = ahora.startOf('day');\nif (base.weekday === 7) base = base.plus({ days: 1 });\nbase = base.minus({ days: base.weekday - 1 });\nconst semanas = Math.round(lunes.diff(base, 'days').days / 7);\nconst ofrece = semanas >= 0 && semanas < 8;\nconst periodos = [h.manana_on && [h.manana_ini, h.manana_fin], h.tarde_on && [h.tarde_ini, h.tarde_fin]].filter(Boolean);\nconst ocupado = new Set();\nfor (const c of r.citas || []) {\n  const [hh, mm] = c.hora.split(':').map(Number);\n  for (let t = hh * 60 + mm; t < hh * 60 + mm + c.dur; t += 30) ocupado.add(c.fecha + ' ' + t);\n}\nconst hhmm = (t) => String(Math.floor(t / 60)).padStart(2, '0') + ':' + String(t % 60).padStart(2, '0');\nconst dias = [];\nfor (let i = 0; i < 6; i++) {\n  const fecha = lunes.plus({ days: i }).toISODate();\n  if (fecha < hoy) { dias.push({ fecha, slots: [], motivo: 'pasado' }); continue; }\n  if (!ofrece || !(h.dias || []).includes(i) || noAtiende.has(fecha)) { dias.push({ fecha, slots: [], motivo: 'no_atiende' }); continue; }\n  const libres = new Set();\n  for (const [a, b] of periodos) for (let t = a; t < b; t += 30) if (!ocupado.has(fecha + ' ' + t)) libres.add(t);\n  const caben = [...libres].filter((t) => { for (let k = t; k < t + dur; k += 30) if (!libres.has(k)) return false; return true; }).sort((a, b) => a - b);\n  const desde = fecha === hoy ? minAhora + 60 : -1;\n  const slots = caben.filter((t) => t >= desde).map(hhmm);\n  dias.push(slots.length ? { fecha, slots } : { fecha, slots: [], motivo: caben.length && fecha === hoy ? 'pasado' : 'sin_cupo' });\n}\nreturn [{ json: { semana_inicio: lunes.toISODate(), semana_fin: lunes.plus({ days: 5 }).toISODate(), profesional: 'Nombre de la profesional en ortodoncia', duracion_min: dur, dias } }];"
      },
      "id": "b2c3d4e5-0103-4000-8000-000000000000",
      "name": "Calcular semana",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        1800
      ]
