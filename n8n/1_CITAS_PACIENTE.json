        1640,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "// INSERT con candado: no guarda si la hora se cruza con otra cita activa de la misma doctora\nconst lit = (v) => (v === null || v === undefined) ? 'null' : \"'\" + String(v).replace(/'/g, \"''\") + \"'\";\nconst num = (v) => { const x = Number(v); if (!Number.isFinite(x)) throw new Error('número inválido'); return String(Math.round(x)); };\nconst c = $input.first().json;\nconst sql = `insert into citas (id, nombre, telefono, email, notas, servicio, servicio_nombre, duracion_min, profesional, fecha, hora)\nselect ${lit(c.id)}, ${lit(c.nombre)}, ${lit(c.telefono)}, ${lit(c.email)}, ${lit(c.notas)}, ${lit(c.servicio)}, ${lit(c.servicio_nombre)},\n       ${num(c.duracion_min)}, ${lit(c.profesional)}, ${lit(c.fecha)}::date, ${lit(c.hora)}::time\nwhere not exists (\n  select 1 from citas o\n  where o.estado <> 'Cancelada' and o.profesional = ${lit(c.profesional)} and o.fecha = ${lit(c.fecha)}::date\n    and o.hora < ${lit(c.hora)}::time + make_interval(mins => ${num(c.duracion_min)})\n    and ${lit(c.hora)}::time < o.hora + make_interval(mins => o.duracion_min)\n)\non conflict do nothing\nreturning id;`;\nreturn [{ json: { sql } }];"
      },
      "id": "b2c3d4e5-0122-4000-8000-000000000000",
      "name": "SQL insertar",
      "type": "n8n-nodes-base.code",
