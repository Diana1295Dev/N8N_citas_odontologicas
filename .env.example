# URL base de la API de disponibilidad (sin barra final). Si se deja vacía, se usan datos de ejemplo.
# GET {VITE_API_BASE}/disponibilidad?semana=AAAA-MM-DD&servicio=ortodoncia
VITE_API_BASE=

# Webhook (n8n) que recibe la cita por POST. Si se deja vacío, el envío se simula.
VITE_WEBHOOK_URL=

# Ingreso de la asistente. Genera ambas líneas con: npm run clave-asistente -- <identificacion> <contraseña>
# Si se dejan vacías, se usa la cuenta de demo 1234567890 / demo1234.
VITE_ASISTENTE_USUARIO=
VITE_ASISTENTE_CLAVE_SHA256=
